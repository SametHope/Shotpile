{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotpile",
  "identifier": "com.samethope.shotpile",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shotpile",
        "width": 1180,
        "height": 880,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SametHope",
    "copyright": "Copyright (c) 2026 SametHope",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Swipe through screenshots, keep or delete",
    "longDescription": "Review screenshots month by month or at random, keep, skip or stage them for deletion, then commit staged files to the Windows Recycle Bin.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
